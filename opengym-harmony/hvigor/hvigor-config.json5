{
  "modelVersion": "6.0.0",
  "dependencies": {
    "@ohos/hvigor": "6.26.9",
    "@ohos/hvigor-ohos-plugin": "6.26.9"
  },
  "execution": {
    // The analyzer is off by default; the ArkTS compiler's own type checking is what matters
    // here, and it runs either way.
    "analyze": "normal",
    "daemon": true,
    "incremental": true,
    "parallel": true,
    "typeCheck": false
  },
  "logging": {
    "level": "info"
  },
  "debugging": {
    "stacktrace": false
  },
  "nodeOptions": {
    "maxOldSpaceSize": 8192,
    "exposeGC": true
  }
}
